# Disable aggressive caching for live World Cup data.
# This file must be in public/_headers for Cloudflare Pages.

/worldcup-2026/*
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

/worldcup-2026/*.json
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

/worldcup-2026/heartbeat.json
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

/worldcup-2026/deploy-marker.txt
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0
