# Cache rules for Cloudflare Pages and Netlify
# Keep optimized images cached for repeat visitors. Filenames include hashes, so this is safe.
/assets/images-optimized/*
  Cache-Control: public, max-age=31536000, immutable

/assets/images-hq/*
  Cache-Control: public, max-age=31536000, immutable

/assets/icons/*
  Cache-Control: public, max-age=31536000, immutable

# Frequency data changes daily through GitHub Actions. The tiny manifest is refreshed often; versioned JSON can be cached longer.
/frequencies/frequency-manifest.json
  Cache-Control: public, max-age=300, must-revalidate

/frequencies/search-index.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/frequencies/frequency-data.v*.json
  Cache-Control: public, max-age=31536000, immutable

/frequencies/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/updates/*
  Cache-Control: public, max-age=300, must-revalidate

/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600
